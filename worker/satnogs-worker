# Decommutation: frame -> telemetry fields (parser) -> points (calibration)
# ----------------------------------------------------------------------------
CW_KEYS = ("text", "wpm", "freq_hz", "snr_db", "t_offset_s")


def calibrate_value(c, x):
    try:
        if "poly" in c:
            return float(sum(a * x ** i for i, a in enumerate(c["poly"])))
        if "expr" in c:
            env = {k: getattr(math, k) for k in dir(math) if not k.startswith("_")}
            return float(eval(c["expr"], {"__builtins__": {}}, {**env, "x": x}))
        return float(x)                                   # unit/description only
    except Exception:
        return None


def decom(ctx, sc, data, cw_meta=None):
    """-> (parser_name, fields dict, error, points [(name, raw, value, unit)])."""
    fields, err, names = {}, None, []
    if cw_meta is not None:
        fields.update(cw_meta)
        names.append("cw")
    pname, pfn = ctx.parser(sc.get("parser", "none"))
    parsed = {}
    if pfn:
        names.append(pname)
        try:
            parsed = jsonable(pfn(data)) or {}
            if not isinstance(parsed, dict):
                parsed = {"value": parsed}
        except Exception as e:
            err = f"{type(e).__name__}: {e}"[:300]
        fields.update(parsed)
    elif pname:
        names.append(pname)
        err = "parser unavailable"
    cal = ctx.calib(sc.get("calib"))
    pts = []
    if cal is not None:                                   # calibrated fields only, with units
        for name, c in cal.items():
            x = parsed.get(name)
            if isinstance(x, (int, float)) and not isinstance(x, bool):
                pts.append((name, x, calibrate_value(c or {}, x), (c or {}).get("unit")))
    else:                                                 # no calibration: numeric fields as raw counts
        for name, x in parsed.items():
            if isinstance(x, (int, float)) and not isinstance(x, bool):
                pts.append((name, x, float(x), None))
    return "+".join(names) or None, (fields if names else None), err, pts


def store_decom(ctx, db, sc, frame_id, obs_id, norad, start, t_offset, data, cw_meta, valid):
    pname, fields, err, pts = decom(ctx, sc, data, cw_meta)
    if pname:
        db.execute("INSERT OR REPLACE INTO telemetry VALUES (?,?,?,?)",
                   (frame_id, pname, json.dumps(fields) if fields is not None else None, err))
    if not valid or not pts:
        return 0
    t = parse_utc(start)
    tstr = (t + timedelta(seconds=t_offset or 0)).strftime("%Y-%m-%dT%H:%M:%S.%fZ")[:-4] + "Z" if t else start
    db.executemany("INSERT INTO points VALUES (?,?,?,?,?,?,?,?)",
                   [(obs_id, frame_id, norad, tstr, n, raw, v, u) for n, raw, v, u in pts])
    return len(pts)


