# ----------------------------------------------------------------------------
# IQ access
# ----------------------------------------------------------------------------
class IQ:
    """Random access to a SigMF complex recording as complex64 chunks."""
    _types = {"ci16_le": (np.int16, 2), "ci16": (np.int16, 2), "ci8": (np.int8, 2),
              "ci8_le": (np.int8, 2), "cf32_le": (np.float32, 2), "cf32": (np.float32, 2)}

    def __init__(self, path, datatype):
        if datatype not in self._types:
            raise ValueError(f"unsupported datatype {datatype}")
        self.datatype = datatype
        self.base, self.per = self._types[datatype]
        self.raw = np.memmap(path, dtype=self.base, mode="r")
        self.n = len(self.raw) // 2
        self.scale = 1 / 32768 if self.base == np.int16 else 1 / 128 if self.base == np.int8 else 1.0

    def read(self, a, b):
        a, b = max(0, int(a)), min(self.n, int(b))
        if b <= a:
            return np.zeros(0, np.complex64)
        v = np.asarray(self.raw[2 * a:2 * b], dtype=np.float32) * np.float32(self.scale)
        return v.view(np.complex64)


# ----------------------------------------------------------------------------
# Burst detection: in-band energy per block from short FFTs
# ----------------------------------------------------------------------------
def band_energy(iq, block, half_frac, chunk_blocks=2048):
    """Energy within |f| <= half_frac*fs for consecutive blocks of `block` samples."""
    nfft = 1 << int(np.ceil(np.log2(block)))
    f = np.fft.fftfreq(nfft)
    mask = np.abs(f) <= half_frac
    nb = iq.n // block
    out = np.empty(nb)
    for c0 in range(0, nb, chunk_blocks):
        c1 = min(nb, c0 + chunk_blocks)
        x = iq.read(c0 * block, c1 * block).reshape(c1 - c0, block)
        x = x - x.mean()
        X = np.fft.fft(x, nfft, axis=1)
        out[c0:c1] = (np.abs(X[:, mask]) ** 2).sum(axis=1)
    return 10 * np.log10(out + 1e-30)


def find_runs(p_db, thresh_db, min_blocks, max_gap):
    floor = float(np.median(p_db))
    hot = p_db > floor + thresh_db
    runs, i, n = [], 0, len(hot)
    while i < n:
        if not hot[i]:
            i += 1
            continue
        j = i
        while True:
            nxt = j + 1
            while nxt < n and not hot[nxt] and nxt - j <= max_gap:
                nxt += 1
            if nxt < n and hot[nxt] and nxt - j <= max_gap + 1:
                j = nxt
            else:
                break
        if j - i + 1 >= min_blocks:
            runs.append((i, j + 1))
        i = j + 1
    return runs, floor


# ----------------------------------------------------------------------------
# Sample rate from the symbol clock (generalised symrate.py)
# ----------------------------------------------------------------------------
def occupied_fraction(iq, bursts, quiet, block, nfft=256):
    """Half-width of the bursts' 99% occupied band, in cycles/sample (rate-independent)."""
    pb = [psd(iq.read(a, b), nfft) for a, b in bursts[:40]]
    pn = [psd(iq.read(q * block, (q + 1) * block), nfft) for q in quiet[:: max(1, len(quiet) // 100)]]
    pb, pn = [p for p in pb if p is not None], [p for p in pn if p is not None]
    if not pb or not pn:
        return 0.45
    ex = np.clip(np.mean(pb, axis=0) - np.mean(pn, axis=0), 0, None)
    f = np.fft.fftshift(np.fft.fftfreq(nfft))
    if ex.sum() <= 0:
        return 0.45
    cum = np.cumsum(ex) / ex.sum()
    lo, hi = f[np.searchsorted(cum, 0.005)], f[min(np.searchsorted(cum, 0.995), nfft - 1)]
    return float(np.clip(1.25 * max(abs(lo), abs(hi)), 0.04, 0.45))


def clock_spectrum(iq, bursts, max_bursts, half_frac=0.45, N=1 << 20, offsets=None):
    """offsets: per-burst carrier offset (cycles/sample) to remove before band-limiting."""
    P = np.zeros(N // 2 + 1)
    used = 0
    offsets = list(offsets) if offsets is not None else [0.0] * len(bursts)
    order = sorted(range(len(bursts)), key=lambda i: bursts[i][0] - bursts[i][1])[:max_bursts]
    for i in order:                                   # longest first
        a, b = bursts[i]
        seg = iq.read(a, min(b, a + N + 2))
        if len(seg) < 256:
            continue
        if offsets[i]:
            seg = (seg * np.exp(-2j * np.pi * offsets[i] * np.arange(len(seg)))).astype(np.complex64)
        if half_frac < 0.45:                     # band-limit: keeps FM demod above threshold
            X = np.fft.fft(seg)
            X[np.abs(np.fft.fftfreq(len(seg))) > half_frac] = 0
            seg = np.fft.ifft(X).astype(np.complex64)
        d = np.angle(seg[1:] * np.conj(seg[:-1]))
        d = np.convolve(d, np.ones(3) / 3, mode="same")
        e = np.diff(d) ** 2
        e -= e.mean()
        e *= np.hanning(len(e))
        S = np.abs(np.fft.rfft(e, N)) ** 2
        tot = S.sum()
        if tot > 0:
            P += S / tot
            used += 1
    # whiten with a moving average so sloped noise can't win
    w = 4001
    c = np.cumsum(np.concatenate(([0.0], P)))
    lo = np.clip(np.arange(len(P)) - w // 2, 0, len(P))
    hi = np.clip(np.arange(len(P)) + w // 2 + 1, 0, len(P))
    base = (c[hi] - c[lo]) / (hi - lo)
    return P / (base + 1e-30), used, N


def find_line(Pw, N, f_lo, f_hi):
    idx = np.where((np.fft.rfftfreq(N) > f_lo) & (np.fft.rfftfreq(N) < f_hi))[0]
    if len(idx) < 5:
        return None, 0.0
    k = int(idx[np.argmax(Pw[idx])])
    if k < 1 or k + 1 >= len(Pw):
        return None, 0.0
    y0, y1, y2 = (np.log(Pw[k + i] + 1e-30) for i in (-1, 0, 1))
    den = y0 - 2 * y1 + y2
    delta = 0.5 * (y0 - y2) / den if den != 0 else 0.0
    prom = 10 * np.log10(Pw[k] / np.median(Pw[idx]))
    return (k + delta) / N, float(prom)


def nominal_rate(flowgraph, baud):
    """IQ dump sample rate chosen by the SatNOGS flowgraphs, or None if unknown.

    Mirrors satnogs-flowgraphs' decimation rule as reimplemented in
    kng/satnogs-client-docker addons/scripts/find_samp_rate.py:
    audio rate 48 kHz, sps 4. Confirmed on station 5263 for satnogs_fsk.py
    @ 9600 (57,600). The per-pass clock measurement checks it every time.
    """
    def dec(mult):
        d = 2
        while d * baud < 48000:
            d += 1
        if d % mult:
            d += mult - d % mult
        return d

    fg = flowgraph or ""
    if not fg.startswith("satnogs_"):
        return None
    if "_sstv" in fg or "_apt" in fg:
        return 4 * 4160 * 4
    if any(k in fg for k in ("_bpsk", "_ssb", "_fsk", "_qubik")):
        if not baud or baud < 1:
            return None
        if "_bpsk" in fg or "_ssb" in fg:
            return float(dec(4) * baud)
        return float(max(4, dec(2)) * baud)
    return 48000.0                      # cw, fm, afsk, ...: fixed audio-rate dump


def measure_clock(iq, bursts, f0, frac, min_db, cfg, half_frac, offsets=None):
    """Symbol-clock line near f0 (cycles/sample, +-frac). Returns (f, prom_db, reason)."""
    Pw, used, N = clock_spectrum(iq, bursts, cfg["max_bursts_for_rate"], half_frac, offsets=offsets)
    if used == 0:
        return None, None, "no usable bursts"
    f, prom = find_line(Pw, N, f0 * (1 - frac), f0 * (1 + frac))
    if f and prom >= min_db:
        return f, prom, None
    return None, prom, f"clock line too weak ({prom:.1f} dB)"


def measure_rate_blind(iq, bursts, baud, cfg, half_frac):
    """Unknown flowgraph: infer the rate assuming the nominal baud is exact."""
    Pw, used, N = clock_spectrum(iq, bursts, cfg["max_bursts_for_rate"], half_frac)
    if used == 0:
        return None, None
    f, prom = find_line(Pw, N, max(1 / 64, baud / 2.4e6), 0.45)
    if f and prom >= cfg["clock_min_db_blind"]:
        return baud / f, prom
    return None, prom


# ----------------------------------------------------------------------------
# Per-burst measurements
# ----------------------------------------------------------------------------
def psd(x, nfft):
    n = len(x) // nfft
    if n == 0:
        return None
    seg = x[: n * nfft].reshape(n, nfft) * np.hanning(nfft)
    return np.fft.fftshift((np.abs(np.fft.fft(seg, axis=1)) ** 2).mean(axis=0))


def measure_bursts(iq, bursts, quiet_blocks, block, rate, baud, half_hz):
    nfft = int(2 ** np.clip(np.round(np.log2(rate / 200)), 6, 12))   # ~200 Hz bins
    f = np.fft.fftshift(np.fft.fftfreq(nfft, 1 / rate))
    band = np.abs(f) <= half_hz
    # noise PSD from quiet blocks spread across the pass
    pick = quiet_blocks[np.linspace(0, len(quiet_blocks) - 1, min(200, len(quiet_blocks))).astype(int)] \
        if len(quiet_blocks) else []
    noise = [psd(iq.read(b * block, b * block + max(block, nfft)), nfft) for b in pick]
    noise = [p for p in noise if p is not None]
    if not noise:
        return [{} for _ in bursts]
    Pn = np.mean(noise, axis=0)
    out = []
    for a, b in bursts:
        Pb = psd(iq.read(a, b), nfft)
        if Pb is None:
            out.append({})
            continue
        ex = np.clip(Pb - Pn, 0, None) * band
        tot = ex.sum()
        if tot <= 0:
            out.append({})
            continue
        cum = np.cumsum(ex) / tot
        lo = f[np.searchsorted(cum, 0.005)]
        hi = f[min(np.searchsorted(cum, 0.995), nfft - 1)]
        occ = (f >= lo) & (f <= hi)
        s, n = ex[occ].sum(), Pn[occ].sum()
        bw = max(hi - lo, rate / nfft)
        snr = 10 * np.log10(s / n) if n > 0 and s > 0 else None
        out.append({
            "offset_hz": float((f * ex).sum() / tot),
            "lo_hz": float(lo), "hi_hz": float(hi),
            "snr_db": snr,
            "ebn0_db": snr + 10 * np.log10(bw / baud) if snr is not None and baud else None,
        })
    return out


def group_bursts(meas, gap_hz):
    """Group bursts into transmitters by frequency offset (split where sorted
    offsets jump by more than gap_hz). Group 0 = median offset nearest 0 Hz.
    Bursts without an offset estimate join group 0. gap_hz 0 = one group."""
    if not meas:
        return []
    have = sorted((i for i, m in enumerate(meas) if m.get("offset_hz") is not None),
                  key=lambda i: meas[i]["offset_hz"])
    rest = [i for i, m in enumerate(meas) if m.get("offset_hz") is None]
    if not have or not gap_hz:
        return [list(range(len(meas)))]
    groups = [[have[0]]]
    for i in have[1:]:
        if meas[i]["offset_hz"] - meas[groups[-1][-1]]["offset_hz"] > gap_hz:
            groups.append([i])
        else:
            groups[-1].append(i)
    groups.sort(key=lambda gr: (abs(float(np.median([meas[i]["offset_hz"] for i in gr]))), -len(gr)))
    groups[0] += rest
    return [sorted(gr) for gr in groups]


def longest_run(idx, block):
    """Longest run of consecutive block indices -> (start_sample, end_sample)."""
    if len(idx) == 0:
        return None
    breaks = np.where(np.diff(idx) != 1)[0]
    starts = np.concatenate(([0], breaks + 1))
    ends = np.concatenate((breaks, [len(idx) - 1]))
    k = int(np.argmax(ends - starts))
    return int(idx[starts[k]]) * block, (int(idx[ends[k]]) + 1) * block


def subtract_intervals(iv, cuts):
    """Interval iv minus the union of cuts -> list of pieces."""
    pieces = [iv]
    for c0, c1 in cuts:
        nxt = []
        for a, b in pieces:
            if c1 <= a or c0 >= b:
                nxt.append((a, b))
                continue
            if a < c0:
                nxt.append((a, c0))
            if c1 < b:
                nxt.append((c1, b))
        pieces = nxt
    return pieces


# ----------------------------------------------------------------------------
# Decoding
# ----------------------------------------------------------------------------
def kiss_frames(buf):
    frames = []
    for chunk in buf.split(b"\xc0"):
        if not chunk:
            continue
        data, esc = bytearray(), False
        for c in chunk:
            if esc:
                data.append({0xDC: 0xC0, 0xDD: 0xDB}.get(c, c))
                esc = False
            elif c == 0xDB:
                esc = True
            else:
                data.append(c)
        if data and data[0] == 0x00:            # 0x09 = gr-satellites timestamp frame
            frames.append(bytes(data[1:]))
    return frames


def write_padded(iq, src, dst, pad_samples):
    """Copy for gr-satellites: int16/complex64 input plus trailing zeros."""
    with open(dst, "wb") as out:
        if iq.base == np.int8:                  # gr-satellites has no int8 input
            for a in range(0, iq.n, 1 << 22):
                out.write((np.asarray(iq.raw[2 * a:2 * min(iq.n, a + (1 << 22))], np.int16) * 256).tobytes())
        else:
            with open(src, "rb") as f:
                shutil.copyfileobj(f, out, 1 << 22)
        zero = np.zeros(2 * min(pad_samples, 1 << 20), np.int16 if iq.base != np.float32 else np.float32)
        left = pad_samples
        while left > 0:
            k = min(left, len(zero) // 2)
            out.write(zero[: 2 * k].tobytes())
            left -= k
    return "--rawfile" if iq.base == np.float32 else "--rawint16"


def patch_decode_copy(path, dtype, shifts, blanks, noise_span):
    """Edit the decoder's copy in place: re-centre this transmitter's bursts
    (shifts: (a, b, cycles/sample)) and replace other transmitters' bursts with
    station noise (blanks: (a, b)) so they can't pull the demodulator's
    frequency/clock tracking. Silence works worse than noise."""
    raw = np.memmap(path, dtype=dtype, mode="r+")
    x = raw.reshape(-1, 2)
    n = len(x)
    lim = 32767 if dtype == np.int16 else None
    noise = None
    if noise_span and noise_span[1] - noise_span[0] >= 256:
        q0, q1 = noise_span
        noise = x[q0:min(q1, n), 0].astype(np.float64) + 1j * x[q0:min(q1, n), 1]

    def put(a, b, c):
        if lim:
            x[a:b, 0] = np.clip(np.round(c.real), -lim - 1, lim)
            x[a:b, 1] = np.clip(np.round(c.imag), -lim - 1, lim)
        else:
            x[a:b, 0], x[a:b, 1] = c.real, c.imag

    for a, b, f in shifts:
        a, b = max(0, int(a)), min(n, int(b))
        if b > a and f:
            c = x[a:b, 0].astype(np.float64) + 1j * x[a:b, 1]
            put(a, b, c * np.exp(-2j * np.pi * f * np.arange(a, b)))
    rng = np.random.default_rng(0)
    for a, b in blanks:
        a, b = max(0, int(a)), min(n, int(b))
        if b <= a:
            continue
        c = np.resize(np.roll(noise, int(rng.integers(len(noise)))), b - a) if noise is not None \
            else np.zeros(b - a)
        put(a, b, c)
    raw.flush()
    del x, raw


HEXLINE = re.compile(r"^[0-9a-f]{4}: |^\*+|^pdu[ _]|^contents")


def run_decoder(sat_arg, iq, data_path, rate, work, cfg, shifts=(), blanks=(), noise_span=None):
    os.makedirs(work, exist_ok=True)
    tag = f"{os.getpid()}"
    padded, kiss = os.path.join(work, f"in-{tag}.raw"), os.path.join(work, f"out-{tag}.kiss")
    try:
        flag = write_padded(iq, data_path, padded, int(cfg["pad_seconds"] * rate))
        if shifts or blanks:
            patch_decode_copy(padded, np.float32 if flag == "--rawfile" else np.int16,
                              shifts, blanks, noise_span)
        cmd = [cfg["gr_satellites"], str(sat_arg), flag, padded, "--samp_rate", f"{rate:.3f}",
               "--iq", "--kiss_out", kiss, "--hexdump"]
        log.debug("decode: %s", " ".join(cmd))
        t0 = time.time()
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=cfg["decode_timeout_s"], text=True, errors="replace")
        # hexdump output is noise; keep only non-hexdump lines for error reports
        err = "\n".join(l for l in (p.stdout or "").splitlines()
                        if l.strip() and not HEXLINE.match(l)).strip()
        if "not found" in err and "atellite" in err:
            return None, f"gr-satellites does not know {sat_arg}"
        if p.returncode != 0:
            return None, f"gr-satellites exit {p.returncode}: {err[-400:]}"
        frames = kiss_frames(open(kiss, "rb").read()) if os.path.exists(kiss) else []
        log.debug("  decoded %d frames in %.0f s", len(frames), time.time() - t0)
        return frames, None
    except subprocess.TimeoutExpired:
        return None, "gr-satellites timed out"
    finally:
        for p_ in (padded, kiss):
            if os.path.exists(p_):
                os.unlink(p_)


# ----------------------------------------------------------------------------
# Telemetry parsers
# ----------------------------------------------------------------------------
def kaitai_dict(obj, depth=0):
    if depth > 12:
        return None
    if isinstance(obj, (bytes, bytearray)):
        return obj.hex()
    if isinstance(obj, (int, float, str, bool)) or obj is None:
        return obj
    if isinstance(obj, list):
        return [kaitai_dict(v, depth + 1) for v in obj]
    if hasattr(obj, "name") and hasattr(obj, "value") and type(obj).__module__ != "builtins":
        return obj.name                          # Enum
    if hasattr(obj, "_io"):
        out = {}
        for k in dir(obj):
            if k.startswith("_") or k in ("close", "from_file", "from_bytes", "from_io"):
                continue
            try:
                v = getattr(obj, k)
            except Exception:
                continue
            if callable(v) and not hasattr(v, "_io"):
                continue
            out[k] = kaitai_dict(v, depth + 1)
        return out
    return str(obj)


def jsonable(d):
    return json.loads(json.dumps(d, default=lambda o: o.hex() if isinstance(o, (bytes, bytearray))
                                 else getattr(o, "name", str(o))))


def load_parser(spec, cfgdir, cache_dir):
    """Returns (name, fn(bytes)->dict) or (None, None)."""
    if not spec or spec == "none":
        return None, None
    if spec.startswith("satnogs:"):
        from satnogsdecoders import decoder as sd
        cls = getattr(sd, spec.split(":", 1)[1])

        def parse(b):
            s = cls.from_bytes(b)
            return sd.get_fields(s) or kaitai_dict(s)
        return spec, parse
    path, _, clsname = spec.partition(":")
    path = path if os.path.isabs(path) else os.path.join(cfgdir, path)
    if path.endswith(".ksy"):
        out = os.path.join(cache_dir, "ksy")
        os.makedirs(out, exist_ok=True)
        mod = os.path.join(out, os.path.basename(path)[:-4] + ".py")
        if not os.path.exists(mod) or os.path.getmtime(mod) < os.path.getmtime(path):
            subprocess.run(["kaitai-struct-compiler", "-t", "python", "--outdir", out, path],
                           check=True, capture_output=True)
        path = mod
    spec_ = importlib.util.spec_from_file_location(f"parser_{abs(hash(path))}", path)
    m = importlib.util.module_from_spec(spec_)
    spec_.loader.exec_module(m)
    if clsname:
        cls = getattr(m, clsname)
    else:
        from kaitaistruct import KaitaiStruct
        cls = next(v for v in vars(m).values()
                   if isinstance(v, type) and issubclass(v, KaitaiStruct) and v is not KaitaiStruct
                   and v.__module__ == m.__name__)
    return spec, lambda b: kaitai_dict(cls.from_bytes(b))


