class Ctx:
    def __init__(self, base, config_path, db_path):
        self.base = base
        self.iq_dir = os.path.join(base, "iq")
        self.queue_dir = os.path.join(base, "queue")
        self.work = os.path.join(base, "work")
        self.cache = os.path.join(base, "cache")
        self.config_path = config_path
        self.cfgdir = os.path.dirname(os.path.abspath(config_path))
        conf = {}
        if os.path.exists(config_path):
            if yaml is None:
                raise SystemExit("python3-yaml is needed to read " + config_path)
            conf = yaml.safe_load(open(config_path)) or {}
        self.settings = {**SETTINGS, **(conf.get("settings") or {})}
        self.defaults = {**DEFAULTS, **(conf.get("defaults") or {})}
        self.sats = {int(k): (v or {}) for k, v in (conf.get("satellites") or {}).items()}
        self.db = db_open(db_path)
        self._parsers = {}
        self.mode_override = None
        self._calibs = {}

    def satcfg(self, norad):
        c = dict(self.defaults)
        c.update(self.sats.get(norad, {}))
        return c

    def retention(self, norad):
        r = dict(DEFAULTS["retention"])
        r.update(self.defaults.get("retention") or {})
        r.update(self.sats.get(norad, {}).get("retention") or {})
        return r

    def calib(self, spec):
        """Calibration file -> {field: {poly|expr, unit, desc}} or None."""
        if not spec:
            return None
        if spec not in self._calibs:
            path = spec if os.path.isabs(spec) else os.path.join(self.cfgdir, spec)
            try:
                self._calibs[spec] = (yaml.safe_load(open(path)) or {}).get("fields") or {}
            except Exception as e:
                log.error("calibration %s unavailable: %s", spec, e)
                self._calibs[spec] = None
        return self._calibs[spec]

    def parser(self, spec):
        if spec not in self._parsers:
            try:
                self._parsers[spec] = load_parser(spec, self.cfgdir, self.cache)
            except Exception as e:
                log.error("parser %s unavailable: %s", spec, e)
                self._parsers[spec] = (spec, None)
        return self._parsers[spec]


def process(ctx, obs_id):
    meta_path = os.path.join(ctx.iq_dir, f"{obs_id}.sigmf-meta")
    data_path = os.path.join(ctx.iq_dir, f"{obs_id}.sigmf-data")
    meta = json.load(open(meta_path))
    g = meta["global"]
    if not os.path.exists(data_path) and g.get("satnogs:iq_deleted"):
        raise FileNotFoundError(f"IQ deleted by retention on {g['satnogs:iq_deleted']}; "
                                f"results from the last processing are kept")
    cap = meta["captures"][0]
    norad, baud = g.get("satnogs:norad_id"), g.get("satnogs:baud") or 0
    flow = g.get("satnogs:flowgraph") or "?"
    freq = cap.get("core:frequency")
    sc = ctx.satcfg(norad)
    S = ctx.settings
    iq = IQ(data_path, g.get("core:datatype", "ci16_le"))
    log.info("obs %s: %s (NORAD %s), %d baud, %s, %.0f MB",
             obs_id, g.get("satnogs:satellite_name"), norad, baud, flow, os.path.getsize(data_path) / 1e6)

    # --- pass 1: rate-independent detection (block = 1024 samples, centre half of band)
    p1 = band_energy(iq, 1024, 0.25)
    runs1, floor1 = find_runs(p1, S["burst_threshold_db"], 3, 2)
    coarse = [(a * 1024, b * 1024) for a, b in runs1]
    hot1 = np.zeros(len(p1), bool)
    for a, b in runs1:
        hot1[max(0, a - 3):b + 3] = True
    quiet1 = np.where(~hot1 & (p1 < floor1 + 1.0))[0]

    # --- sample rate: set by the station's flowgraph (exact), not by the satellite
    if sc.get("sample_rate"):
        rate, rate_status = float(sc["sample_rate"]), "configured"
    else:
        rate = nominal_rate(flow, baud)
        rate_status = "computed" if rate else "unknown"
    blind_prom = None
    if not rate and baud and coarse:              # unknown flowgraph: infer, assuming exact baud
        rate, blind_prom = measure_rate_blind(iq, coarse, baud, S,
                                              occupied_fraction(iq, coarse, quiet1, 1024))
        rate_status = "inferred" if rate else "unknown"
        log.info("  unknown flowgraph %s: rate %s (assumes exact %d baud)", flow,
                 f"{rate:.1f} inferred" if rate else "not found", baud)
    elif not rate:
        log.info("  unknown flowgraph %s and no bursts: rate unknown", flow)
    else:
        log.info("  rate %.1f S/s (%s)", rate, rate_status)

    mode = (ctx.mode_override or str(sc.get("mode", "")) or "").lower()
    is_cw = mode == "cw" or ("_cw" in flow and mode in ("", "auto"))
    if ctx.mode_override:
        log.info("  mode override: %s (scheduled flowgraph %s)", ctx.mode_override, flow)
    def run_cw():
        # --- CW beacon: own detector/decoder (gr-satellites has no CW). Bursts =
        # whole transmissions, frames = decoded text, telemetry = text/WPM/freq/SNR.
        # SatNOGS's baud for CW is used only as a keying-speed hint (5..60 WPM).
        cw = cw_analyse(iq, rate, S, baud) if rate else []
        bursts = [(c["a"], c["b"]) for c in cw]
        meas = [{"offset_hz": c["freq_hz"], "centroid_hz": c["freq_hz"], "lo_hz": c["freq_hz"] - c["bw_hz"],
                 "hi_hz": c["freq_hz"] + c["bw_hz"], "snr_db": c["snr_db"], "ebn0_db": None,
                 "carrier_hz": None, "carrier_db": None} for c in cw]
        tx_of = {i: 0 for i in range(len(cw))}
        cw_info = [{"text": c["text"], "wpm": c["wpm"] and round(c["wpm"], 1), "freq_hz": round(c["freq_hz"], 1),
                    "snr_db": c["snr_db"] and round(c["snr_db"], 1), "t_offset_s": round(c["a"] / rate, 2)}
                   for c in cw if c["text"].strip()]
        texts = [c["text"].encode() for c in cw if c["text"].strip()]
        txs = [{"idx": list(range(len(cw))), "offset_hz": float(np.median([c["freq_hz"] for c in cw])),
                "baud": None, "ppm": None, "prom": None, "baud_used": baud, "source": "n/a (CW)",
                "frames": texts}] if cw else []
        for i, c in enumerate(cw):
            log.info("  CW %5.1f s +%4.1f s @ %+.0f Hz, %s WPM, SNR %s dB: %s", c["a"] / rate,
                     (c["b"] - c["a"]) / rate, c["freq_hz"], c["wpm"] and f"{c['wpm']:.0f}",
                     c["snr_db"] is not None and f"{c['snr_db']:.1f}", c["text"] or "(nothing decoded)")
        measured_baud = ppm = prom = None
        baud_used, baud_source, decode_rate = baud, "n/a (CW)", rate
        decoder = sat_arg = "cw"
        error = None if rate else "sample rate unknown"
        status = "failed" if not rate else "empty" if not cw else "decoded" if texts else "no_frames"
        return (bursts, meas, tx_of, txs, cw_info, measured_baud, ppm, prom, baud_used, baud_source,
                decode_rate, decoder, sat_arg, error, status)

    cw_info = []
    if is_cw:
        (bursts, meas, tx_of, txs, cw_info, measured_baud, ppm, prom, baud_used, baud_source,
         decode_rate, decoder, sat_arg, error, status) = run_cw()
    else:
        # --- pass 2: band-limited detection at the true rate (10 ms blocks)
        bursts, meas, quiet_span = coarse, [{} for _ in coarse], None
        if rate:
            block = max(64, int(round(rate * 0.010)))
            half_hz = min(0.8 * baud + 1000, 0.45 * rate) if baud else 0.25 * rate
            p2 = band_energy(iq, block, half_hz / rate)
            runs2, floor = find_runs(p2, S["burst_threshold_db"], 4, 2)
            bursts = [(a * block, b * block) for a, b in runs2]
            hot = np.zeros(len(p2), bool)
            for a, b in runs2:
                hot[max(0, a - 5):b + 5] = True
            quiet = np.where(~hot & (p2 < floor + 1.0))[0]
            meas = measure_bursts(iq, bursts, quiet, block, rate, baud, half_hz,
                                  S["carrier_min_db"] if "_bpsk" in flow else None)
            quiet_span = longest_run(quiet, block)
        log.info("  %d bursts", len(bursts))

        # --- transmitters: bursts grouped by frequency offset. Group 0 (nearest 0 Hz)
        # is the scheduled satellite, since the Doppler correction was computed for it;
        # other groups are e.g. siblings sharing the channel. Each group gets its own
        # baud measurement and its own decode run (see run_decoder).
        groups = group_bursts(meas, [a / rate if rate else a for a, _ in bursts], S["cluster_gap_hz"],
                              S["cluster_drift_hz_s"]) if bursts else []
        tx_of = {}
        txs = []
        for ti, members in enumerate(groups):
            offs = [meas[i]["offset_hz"] for i in members if meas[i].get("offset_hz") is not None]
            t = {"idx": members, "offset_hz": float(np.median(offs)) if offs else 0.0, "baud": None,
                 "ppm": None, "prom": None, "baud_used": baud, "source": "nominal", "frames": []}
            for i in members:
                tx_of[i] = ti
            if rate and baud and rate_status != "inferred" and ti < S["max_transmitters"]:
                widths = [(meas[i]["hi_hz"] - meas[i]["lo_hz"]) / 2 for i in members
                          if meas[i].get("hi_hz") is not None]
                hf = float(np.clip(1.25 * np.median(widths) / rate, 0.04, 0.45)) if widths else 0.45
                f, t["prom"], why = measure_clock(
                    iq, [bursts[i] for i in members], baud / rate, S["baud_search_frac"], S["clock_min_db"],
                    S, hf, [(meas[i].get("offset_hz") or 0.0) / rate for i in members])
                if f:
                    t["baud"] = f * rate
                    t["ppm"] = (t["baud"] / baud - 1) * 1e6
                    t["baud_used"], t["source"] = t["baud"], "measured"
            txs.append(t)
        if txs and txs[0]["source"] == "nominal" and baud and norad is not None and rate_status != "inferred":
            hist = [r[0] for r in ctx.db.execute(
                "SELECT measured_baud FROM observations WHERE norad_id=? AND baud=? AND obs_id!=? "
                "AND measured_baud IS NOT NULL ORDER BY start_utc DESC LIMIT 10", (norad, baud, obs_id))]
            if hist:
                txs[0]["baud_used"], txs[0]["source"] = float(np.median(hist)), "history"
        for ti, t in enumerate(txs):
            who = "scheduled" if ti == 0 else "other"
            if t["baud"]:
                b_txt = f"baud {t['baud']:.2f} ({t['ppm']:+.0f} ppm, clock line {t['prom']:.1f} dB)"
            elif t["source"] == "history":
                b_txt = f"baud {t['baud_used']:.2f} from this satellite's earlier passes"
            else:
                b_txt = "baud not measured" + (f" (clock line {t['prom']:.1f} dB)" if t["prom"] else "")
            log.info("  transmitter %d (%s): %d bursts @ %+.0f Hz, %s", ti, who, len(t["idx"]),
                     t["offset_hz"], b_txt)
        if txs and txs[0]["ppm"] is not None and abs(txs[0]["ppm"]) > S["baud_flag_ppm"]:
            log.warning("  baud %+.0f ppm from nominal: satellite oscillator, or wrong rate rule for %s "
                        "(see `status` flowgraph check)", txs[0]["ppm"], flow)
        # BPSK carriers: the squared-signal line can lock onto something else on
        # weak bursts (TEVEL2 sibling at ~3 dB: -8411 Hz where its track is -5.7 kHz).
        # Reject estimates far from the burst's spectral centroid, then fill missing
        # ones from the same transmitter's good ones (interpolated in time; residual
        # Doppler drifts smoothly) so every burst can be centred.
        for i, m in enumerate(meas):
            if m.get("carrier_hz") is not None and baud and \
                    abs(m["carrier_hz"] - m["centroid_hz"]) > S["carrier_max_dev"] * baud:
                m["carrier_rejected"] = m["carrier_hz"]
                m["carrier_hz"] = None
                m["offset_hz"] = m["centroid_hz"]
        for t in txs:
            ex = sorted((bursts[i][0], meas[i]["carrier_hz"]) for i in t["idx"]
                        if meas[i].get("carrier_hz") is not None)
            for i in t["idx"]:
                if ex and meas[i].get("carrier_hz") is None:
                    meas[i]["carrier_fill"] = float(np.interp(bursts[i][0], [e[0] for e in ex], [e[1] for e in ex]))
        n_rej = sum(1 for m in meas if "carrier_rejected" in m)
        n_fill = sum(1 for m in meas if "carrier_fill" in m)
        if n_rej or n_fill:
            log.info("  carriers: %d rejected as implausible, %d interpolated", n_rej, n_fill)
        t0 = txs[0] if txs else {"baud": None, "ppm": None, "prom": None, "baud_used": baud, "source": "nominal"}
        measured_baud, ppm, prom = t0["baud"], t0["ppm"], t0["prom"] if t0["prom"] is not None else blind_prom
        baud_used, baud_source = t0["baud_used"], t0["source"]
        decode_rate = rate * baud / baud_used if rate and baud and baud_used else rate

        # --- decode: one run per transmitter (scheduled first)
        decoder = str(sc.get("decoder", "auto"))
        sat_arg = None
        if decoder == "auto":
            sat_arg = norad
        elif decoder != "none":
            sat_arg = decoder if not decoder.endswith((".yml", ".yaml")) or os.path.isabs(decoder) \
                else os.path.join(ctx.cfgdir, decoder)
        error, status = None, None
        margin = int(S["decode_margin_s"] * rate) if rate else 0
        if not bursts and not sc.get("always_decode"):
            status = "empty"
        elif sat_arg is None:
            status = "no_decoder"
        elif not rate:
            status, error = "failed", "sample rate unknown"
        else:
            runs = list(enumerate(txs[: S["max_transmitters"]])) or [(0, None)]
            for ti, t in runs:
                if t is not None and ti > 0 and len(t["idx"]) < S["min_bursts_other"]:
                    continue
                own = sorted(t["idx"], key=lambda i: bursts[i][0]) if t else []
                cores = [bursts[i] for i in own]
                others = [(bursts[i][0] - margin, bursts[i][1] + margin) for i in range(len(bursts)) if i not in own]
                # Decoder input = this transmitter's bursts only, back to back, each
                # centred on its own carrier: exact (BPSK squared-signal line) or
                # interpolated -> FLL off, Costas locks at once; otherwise the coarse
                # centroid, applied only when far off (the FLL does better near 0 Hz).
                segs, all_centred = [], bool(own)
                for i in own:
                    m = meas[i]
                    c = m.get("carrier_hz") if m.get("carrier_hz") is not None else m.get("carrier_fill")
                    if c is None:
                        all_centred = False
                        c = m.get("offset_hz") if abs(m.get("offset_hz") or 0.0) > S["recentre_min_hz"] else 0.0
                    a0, b0 = bursts[i][0] - margin, bursts[i][1] + margin
                    bl = [p for o in others for p in subtract_intervals(o, cores) if p[1] > a0 and p[0] < b0]
                    segs.append((a0, b0, (c or 0.0) / rate, bl))
                extra = list(S["exact_carrier_args"]) if all_centred else []
                extra += [str(v) for v in (sc.get("decoder_args") or [])]
                noise = iq.read(*quiet_span).astype(np.complex128) if quiet_span else None
                # gr-satellites assumes the SatYAML baud; scaling the rate gives it
                # this transmitter's true samples/symbol
                dr = rate * baud / t["baud_used"] if t and baud and t["baud_used"] else rate
                # gr-satellites' BPSK path is not deterministic run to run (thread
                # scheduling); frames are CRC-checked, so repeat and keep the union.
                # Stop when two runs in a row agree (deterministic decoders, e.g. FSK).
                fr, err, prev, n_runs = [], None, None, 0
                os.makedirs(ctx.work, exist_ok=True)
                stream = os.path.join(ctx.work, f"tx{ti}-{os.getpid()}.c64")
                if own:
                    build_burst_stream(iq, segs, stream, noise, int(S["pad_seconds"] * rate))
                # FSK: gr-satellites sizes its filters from --deviation (default 5 kHz);
                # the best value varies by satellite (ALSAT-1N: 2 kHz -> 4 frames,
                # 5 kHz -> 1), so sweep it, one run each (FSK decoding is
                # deterministic). BPSK: repeat runs (not deterministic). Frames are
                # CRC-checked either way; keep the union.
                if "_bpsk" in flow or "--deviation" in extra:
                    variants = [[]] * max(1, int(S["decode_runs"]))
                    repeat = True
                else:
                    variants = [["--deviation", str(d)] for d in S["fsk_deviation_sweep"]] or [[]]
                    repeat = False
                hits = {}
                for v in variants:
                    if own:
                        got, err = run_grsat(sat_arg, stream, "--rawfile", dr, S, extra + v)
                    else:                                   # always_decode, no bursts: whole file
                        got, err = run_decoder(sat_arg, iq, data_path, dr, ctx.work, S)
                    if got is None:
                        fr = None if not fr else fr
                        break
                    n_runs += 1
                    new = [x for x in got if x not in fr]
                    fr += new
                    if v:
                        hits[" ".join(v)] = len(set(got))
                    key = sorted(set(got))
                    if repeat and key == prev:
                        break
                    prev = key
                if hits:
                    log.info("  transmitter %d: frames per FSK setting %s",
                             ti, ", ".join(f"{k.split()[-1]} Hz: {n}" for k, n in hits.items()))
                if os.path.exists(stream):
                    os.unlink(stream)
                if n_runs > 1:
                    log.debug("  transmitter %d: %d decode runs", ti, n_runs)
                if fr is None:
                    if ti == 0:
                        error = err
                        break
                    log.warning("  transmitter %d decode failed: %s", ti, err)
                    continue
                log.info("  transmitter %d: %d frames", ti, len(fr))
                if t is not None:
                    t["frames"] = fr
                else:
                    txs = [{"idx": [], "offset_hz": 0.0, "baud": None, "ppm": None, "prom": None,
                            "baud_used": baud, "source": "nominal", "frames": fr}]
            n_any = sum(len(t["frames"]) for t in txs)
            if error and not n_any:
                status = "no_decoder" if "does not know" in error else "failed"
            else:
                status = "decoded" if n_any else "no_frames"

    # CW fallback (per satellite): many satellites beacon CW on the same frequency
    # as their data transmitter, and the data mode is often silent (e.g. KOSEN-1:
    # GMSK scheduled, only CW heard). If the data path found no frames, try CW.
    if (not is_cw and sc.get("cw_fallback") and rate and not ctx.mode_override
            and status in ("empty", "no_frames", "no_decoder", "failed")):
        r = run_cw()
        if r[-1] == "decoded":
            log.info("  no data frames; CW fallback decoded %d message(s)", len(r[3][0]["frames"]))
            (bursts, meas, tx_of, txs, cw_info, measured_baud, ppm, prom, baud_used, baud_source,
             decode_rate, decoder, sat_arg, error, status) = r
            is_cw, cw_fallback = True, True
        else:
            log.info("  no data frames; CW fallback found no CW either")
            cw_fallback = False
    else:
        cw_fallback = False

    # unique frames (scheduled transmitter first), original order
    # (CW: every transmission is a sample in time, so repeats are kept; their
    # hash includes the time offset)
    seen, uniq = set(), []
    for ti, t in enumerate(txs):
        for k, fr in enumerate(t["frames"]):
            cm = cw_info[k] if is_cw and ti == 0 and k < len(cw_info) else None
            h = hashlib.sha1(fr + (f"@{cm['t_offset_s']}".encode() if cm else b"")).hexdigest()
            if h not in seen:
                seen.add(h)
                uniq.append((fr, h, ti, cm))
    if is_cw:      # garbled copy: too short, or too many unresolved characters
        valid = [len(u[0].replace(b" ", b"")) >= S["cw_min_chars"] and
                 u[0].count(b"*") <= S["cw_max_unknown"] * len(u[0].replace(b" ", b"")) for u in uniq]
    else:
        valid = frame_validity([u[0] for u in uniq], S["min_frame_len"])
    prefix = bytes.fromhex(str(sc.get("frame_prefix") or "").replace(" ", ""))
    if prefix:                                  # satellite-specific start, e.g. ALSAT-1N "AL1N\0"
        valid = [v and u[0].startswith(prefix) for u, v in zip(uniq, valid)]
    n_bad = valid.count(False)
    if n_bad:
        log.info("  %d suspect frame(s) kept but not counted (%s)", n_bad,
                 "garbled CW copy" if is_cw else "CRC false positive?")
    n_main = sum(1 for u, v in zip(uniq, valid) if v and u[2] == 0)
    n_other = sum(1 for u, v in zip(uniq, valid) if v and u[2] != 0)
    if status == "decoded" and not n_main + n_other:
        status = "no_frames"

    start = cap.get("core:datetime")
    dur = iq.n / rate if rate else None
    snrs = [meas[i]["snr_db"] for i in (txs[0]["idx"] if txs else []) if meas[i].get("snr_db") is not None]

    # --- database (one transaction)
    db = ctx.db
    with db:
        old = [r[0] for r in db.execute("SELECT frame_id FROM frames WHERE obs_id=?", (obs_id,))]
        db.executemany("DELETE FROM telemetry WHERE frame_id=?", [(i,) for i in old])
        for tbl in ("frames", "bursts", "transmitters", "points"):
            db.execute(f"DELETE FROM {tbl} WHERE obs_id=?", (obs_id,))
        row = {"obs_id": obs_id, "norad_id": norad, "satellite": g.get("satnogs:satellite_name"),
               "start_utc": start, "freq_hz": freq, "baud": baud, "flowgraph": flow, "n_samples": iq.n,
               "sample_rate": rate, "rate_status": rate_status, "clock_line_db": prom,
               "measured_baud": measured_baud, "baud_ppm": ppm, "baud_source": baud_source,
               "decode_rate": decode_rate, "duration_s": dur,
               "n_bursts": len(txs[0]["idx"]) if txs else 0,
               "n_bursts_other": len(bursts) - (len(txs[0]["idx"]) if txs else 0),
               "best_snr_db": max(snrs) if snrs else None,
               "decoder": str(sat_arg) if sat_arg is not None else decoder,
               "n_frames": n_main, "n_frames_other": n_other,
               "status": status, "error": error, "processed_utc": now_utc(),
               "worker_version": VERSION, "data_path": data_path}
        db.execute(f"INSERT OR REPLACE INTO observations ({','.join(row)}) "
                   f"VALUES ({','.join('?' * len(row))})", list(row.values()))
        for ti, t in enumerate(txs):
            db.execute("INSERT INTO transmitters VALUES (?,?,?,?,?,?,?,?,?)",
                       (obs_id, ti, len(t["idx"]), t["offset_hz"], t["baud"], t["ppm"], t["prom"],
                        t["source"], sum(1 for u, v in zip(uniq, valid) if v and u[2] == ti)))
        for i, ((a, b), m) in enumerate(zip(bursts, meas)):
            db.execute("INSERT INTO bursts (obs_id, idx, sample_start, sample_count, t_offset_s, duration_s, "
                       "snr_db, ebn0_db, offset_hz, lo_hz, hi_hz, transmitter, carrier_hz, carrier_db) "
                       "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                       (obs_id, i, a, b - a, a / rate if rate else None, (b - a) / rate if rate else None,
                        m.get("snr_db"), m.get("ebn0_db"), m.get("offset_hz"), m.get("lo_hz"), m.get("hi_hz"),
                        tx_of.get(i), m.get("carrier_hz"), m.get("carrier_db")))
        for i, ((fr, h, ti, cm), ok) in enumerate(zip(uniq, valid)):
            cm = (cm or {"text": fr.decode(errors="replace")}) if is_cw else None
            toff = cm.get("t_offset_s") if cm else None
            cur = db.execute("INSERT INTO frames (obs_id, norad_id, start_utc, idx, length, data, sha1, "
                             "transmitter, valid, t_offset_s) VALUES (?,?,?,?,?,?,?,?,?,?)",
                             (obs_id, norad, start, i, len(fr), fr, h, ti, int(ok), toff))
            store_decom(ctx, db, sc, cur.lastrowid, obs_id, norad, start, toff, fr, cm, ok)

    # --- SigMF meta
    if rate:
        g["core:sample_rate"] = rate
        g["satnogs:samples_per_symbol"] = round(rate / baud_used, 4) if baud_used else None
    else:
        g.pop("core:sample_rate", None)
    g["satnogs:sample_rate_status"] = rate_status
    for k in ("satnogs:clock_line_db", "satnogs:measured_baud", "satnogs:baud_offset_ppm"):
        g.pop(k, None)
    if prom is not None:
        g["satnogs:clock_line_db"] = round(prom, 1)
    if measured_baud:
        g["satnogs:measured_baud"] = round(measured_baud, 3)
        g["satnogs:baud_offset_ppm"] = round(ppm)
    g["satnogs:baud_source"] = baud_source
    g["satnogs:transmitters"] = [
        {"index": ti, "bursts": len(t["idx"]), "offset_hz": round(t["offset_hz"]),
         "measured_baud": round(t["baud"], 3) if t["baud"] else None,
         "frames": sum(1 for u, v in zip(uniq, valid) if v and u[2] == ti)} for ti, t in enumerate(txs)]
    g["satnogs:processed_as"] = ("cw (fallback)" if cw_fallback else "cw") if is_cw else "data"
    g.update({"satnogs:status": status, "satnogs:bursts": row["n_bursts"],
              "satnogs:bursts_other": row["n_bursts_other"], "satnogs:frames": n_main,
              "satnogs:frames_other": n_other,
              "satnogs:decoder": str(sat_arg) if sat_arg is not None else decoder,
              "satnogs:processed": now_utc(), "satnogs:worker_version": VERSION})
    if error:
        g["satnogs:error"] = error
    else:
        g.pop("satnogs:error", None)
    anns = [a for a in meta.get("annotations", []) if a.get("core:label") not in ("burst", "burst-other")]
    for i, ((a, b), m) in enumerate(zip(bursts, meas)):
        ti = tx_of.get(i, 0)
        ann = {"core:sample_start": int(a), "core:sample_count": int(b - a),
               "core:label": "burst" if ti == 0 else "burst-other",
               "core:generator": f"satnogs-worker {VERSION}", "satnogs:transmitter": ti}
        if m and freq:
            ann["core:freq_lower_edge"] = round(freq + m["lo_hz"], 1)
            ann["core:freq_upper_edge"] = round(freq + m["hi_hz"], 1)
        if m:
            ann["satnogs:offset_hz"] = round(m["offset_hz"], 1)
            if m.get("carrier_hz") is not None:
                ann["satnogs:carrier_hz"] = round(m["carrier_hz"], 1)
        if is_cw and i < len(bursts):
            c = next((v for v in cw_info if abs(v["t_offset_s"] - round(a / rate, 2)) < 1e-3), None)
            if c:
                ann["core:comment"] = c["text"]
            if m.get("snr_db") is not None:
                ann["satnogs:snr_db"] = round(m["snr_db"], 2)
                if m.get("ebn0_db") is not None:
                    ann["satnogs:ebn0_db"] = round(m["ebn0_db"], 2)
        anns.append(ann)
    meta["annotations"] = sorted(anns, key=lambda a: a["core:sample_start"])
    tmp = meta_path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(meta, f, indent=2)
    os.replace(tmp, meta_path)
    log.info("  -> %s, %d frames%s%s", status, n_main, f" (+{n_other} from other transmitters)" if n_other else "",
             f" ({error})" if error else "")
    return status


# ----------------------------------------------------------------------------
# Commands
# ----------------------------------------------------------------------------
def client_busy(ctx):
    lim = ctx.settings["busy_seconds"]
    for p in glob.glob(os.path.join(ctx.iq_dir, "current.raw*")):
        try:
            if time.time() - os.path.getmtime(p) < lim:
                return p
        except OSError:
            pass
    return None


# ----------------------------------------------------------------------------
# Observer filter
# ----------------------------------------------------------------------------
def lookup_observer(ctx, obs):
    """SatNOGS username that scheduled obs (cached), or None if not available yet."""
    row = ctx.db.execute("SELECT observer FROM observers WHERE obs_id=?", (obs,)).fetchone()
    if row and row[0]:
        return row[0]
    url = ctx.settings["network_api"].format(id=obs)
    req = urllib.request.Request(url, headers={"User-Agent": f"satnogs-worker/{VERSION}",
                                               "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=ctx.settings["api_timeout_s"]) as r:
            d = json.load(r)
    except (urllib.error.URLError, OSError, ValueError) as e:
        log.warning("obs %s: observer lookup failed: %s", obs, e)
        return None
    if isinstance(d, list):
        d = d[0] if d else {}
    who = d.get("observer") if isinstance(d, dict) else None
    if not who:
        log.warning("obs %s: Network API record has no observer", obs)
        return None
    with ctx.db:
        ctx.db.execute("INSERT OR REPLACE INTO observers VALUES (?,?,?,?)",
                       (obs, who, d.get("station_name"), now_utc()))
    return who


def obs_age_hours(ctx, obs):
    meta = os.path.join(ctx.iq_dir, f"{obs}.sigmf-meta")
    try:
        t = parse_utc(json.load(open(meta))["captures"][0].get("core:datetime"))
    except (OSError, ValueError, KeyError, IndexError):
        t = None
    if t is None:
        try:
            t = datetime.fromtimestamp(os.path.getmtime(meta), timezone.utc)
        except OSError:
            return None
    return (datetime.now(timezone.utc) - t).total_seconds() / 3600


def handle_other(ctx, obs, who, policy):
    """Another user's pass: record it, then delete or keep the IQ unprocessed."""
    meta_path = os.path.join(ctx.iq_dir, f"{obs}.sigmf-meta")
    data_path = os.path.join(ctx.iq_dir, f"{obs}.sigmf-data")
    try:
        meta = json.load(open(meta_path))
        g, cap = meta["global"], meta["captures"][0]
    except (OSError, ValueError, KeyError, IndexError):
        g, cap = {}, {}
    deleted = None
    if policy == "delete":
        for p in (data_path, meta_path):
            if os.path.exists(p):
                os.unlink(p)
        deleted = now_utc()
    row = {"obs_id": obs, "norad_id": g.get("satnogs:norad_id"), "satellite": g.get("satnogs:satellite_name"),
           "start_utc": cap.get("core:datetime"), "freq_hz": cap.get("core:frequency"),
           "baud": g.get("satnogs:baud"), "flowgraph": g.get("satnogs:flowgraph"),
           "status": "other_observer", "error": None, "observer": who, "processed_utc": now_utc(),
           "worker_version": VERSION, "data_path": data_path, "iq_deleted_utc": deleted}
    with ctx.db:
        for tbl in ("frames", "bursts", "transmitters"):
            ctx.db.execute(f"DELETE FROM {tbl} WHERE obs_id=?", (obs,))
        ctx.db.execute(f"INSERT OR REPLACE INTO observations ({','.join(row)}) "
                       f"VALUES ({','.join('?' * len(row))})", list(row.values()))
    log.info("obs %s: scheduled by %s, not us -> %s", obs, who,
             "IQ and metadata deleted" if deleted else "kept unprocessed")


def cmd_run(ctx, args, ids=None):
    lock = open(os.path.join(ctx.base, ".worker.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log.info("another worker is running")
        return 0
    queued = ids is None
    if queued:
        ids = sorted((int(n) for n in os.listdir(ctx.queue_dir) if n.isdigit()), key=int)[: args.max]
    rc = 0
    S = ctx.settings
    own = [str(o).lower() for o in (S["own_observers"] or [])]
    for obs in ids:
        busy = client_busy(ctx)
        if busy:
            log.info("observation in progress (%s), deferring", os.path.basename(busy))
            break
        who = lookup_observer(ctx, obs) if own else None
        if own and who is None:
            age = obs_age_hours(ctx, obs)
            if queued and age is not None and age < S["observer_retry_hours"]:
                log.info("obs %s: observer not known yet, leaving queued", obs)
                continue
            if queued:
                log.warning("obs %s: observer still unknown after %.0f h; processing as our own", obs, age or 0)
        if queued and who and who.lower() not in own and S["others"] != "process":
            handle_other(ctx, obs, who, S["others"])
            q = os.path.join(ctx.queue_dir, str(obs))
            if os.path.exists(q):
                os.unlink(q)
            continue
        try:
            process(ctx, obs)
            if who:
                with ctx.db:
                    ctx.db.execute("UPDATE observations SET observer=? WHERE obs_id=?", (who, obs))
        except FileNotFoundError as e:
            log.error("obs %s: %s", obs, e)
            rc = 1
        except Exception:
            log.exception("obs %s failed", obs)
            rc = 1
            with ctx.db:
                ctx.db.execute("INSERT INTO observations (obs_id, status, error, processed_utc, worker_version) "
                               "VALUES (?, 'failed', ?, ?, ?) ON CONFLICT(obs_id) DO UPDATE SET "
                               "status='failed', error=excluded.error, processed_utc=excluded.processed_utc",
                               (obs, f"{sys.exc_info()[0].__name__}: {sys.exc_info()[1]}"[:400], now_utc(), VERSION))
        # finished either way: don't retry forever (use `reprocess` after a fix)
        q = os.path.join(ctx.queue_dir, str(obs))
        if os.path.exists(q):
            os.unlink(q)
    if queued and ctx.settings["retention_auto"]:
        expired, _ = retention_plan(ctx)
        if expired:
            apply_retention(ctx, expired)
    return rc


# ----------------------------------------------------------------------------
# Retention
# ----------------------------------------------------------------------------
RET_CLASS = {"decoded": "iq_days", "empty": "empty_days", "other_observer": "other_days",
             "no_frames": "undecoded_days", "no_decoder": "undecoded_days", "failed": "undecoded_days"}


def parse_utc(s):
    try:
        return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None


def retention_plan(ctx, now=None):
    """-> (expired, kept_reasons). expired: (obs, path, bytes, status, age_days, limit_days)."""
    now = now or datetime.now(timezone.utc)
    expired, held = [], {}
    for path in sorted(glob.glob(os.path.join(ctx.iq_dir, "*.sigmf-data"))):
        name = os.path.basename(path).split(".")[0]
        if not name.isdigit():
            continue
        obs = int(name)
        if os.path.exists(os.path.join(ctx.queue_dir, name)):
            held["queued"] = held.get("queued", 0) + 1
            continue
        if os.path.exists(os.path.join(ctx.iq_dir, f"{name}.keep")):
            held[".keep"] = held.get(".keep", 0) + 1
            continue
        row = ctx.db.execute("SELECT norad_id, status, start_utc FROM observations WHERE obs_id=?",
                             (obs,)).fetchone()
        if not row or row[1] not in RET_CLASS:
            held["not processed"] = held.get("not processed", 0) + 1
            continue
        norad, status, start = row
        limit = ctx.retention(norad).get(RET_CLASS[status])
        if limit is None or str(limit).strip().lower() in ("forever", "never", ""):
            held["kept forever"] = held.get("kept forever", 0) + 1
            continue
        t = parse_utc(start) or datetime.fromtimestamp(os.path.getmtime(path), timezone.utc)
        age = (now - t).total_seconds() / 86400
        if age >= float(limit):
            expired.append((obs, path, os.path.getsize(path), status, age, float(limit)))
        else:
            held["within limit"] = held.get("within limit", 0) + 1
    return expired, held


def apply_retention(ctx, expired):
    freed = 0
    for obs, path, size, status, age, limit in expired:
        try:
            os.unlink(path)
        except OSError as e:
            log.error("retention: obs %s: %s", obs, e)
            continue
        freed += size
        stamp = now_utc()
        meta_path = os.path.join(ctx.iq_dir, f"{obs}.sigmf-meta")
        try:                      # metadata stays; note that its data file is gone
            meta = json.load(open(meta_path))
            meta["global"]["satnogs:iq_deleted"] = stamp
            tmp = meta_path + ".tmp"
            with open(tmp, "w") as f:
                json.dump(meta, f, indent=2)
            os.replace(tmp, meta_path)
        except (OSError, ValueError, KeyError) as e:
            log.warning("retention: obs %s metadata not updated: %s", obs, e)
        with ctx.db:
            ctx.db.execute("UPDATE observations SET iq_deleted_utc=? WHERE obs_id=?", (stamp, obs))
        log.info("retention: deleted IQ of obs %s (%s, %.1f days old, limit %g) %.0f MB",
                 obs, status, age, limit, size / 1e6)
    return freed


def cmd_retention(ctx, args):
    expired, held = retention_plan(ctx)
    total = sum(e[2] for e in expired)
    for obs, path, size, status, age, limit in expired:
        print(f"  {obs:>9}  {status:<10}  {age:6.1f} d old (limit {limit:g})  {size / 1e6:7.0f} MB")
    print(f"{len(expired)} expired IQ file(s), {total / 1e9:.2f} GB" +
          ("" if not held else "; kept: " + ", ".join(f"{v} {k}" for k, v in sorted(held.items()))))
    if not args.apply:
        print("dry run -- `satnogs-worker retention --apply` deletes them")
        return 0
    freed = apply_retention(ctx, expired)
    print(f"deleted, {freed / 1e9:.2f} GB freed")
    return 0


def cmd_status(ctx, _args):
    q = sorted(n for n in os.listdir(ctx.queue_dir) if n.isdigit()) if os.path.isdir(ctx.queue_dir) else []
    print(f"queued: {len(q)} {' '.join(q[:10])}")
    for r in ctx.db.execute("SELECT status, COUNT(*) FROM observations GROUP BY status"):
        print(f"  {r[0]:<15} {r[1]}")
    print("recent:")
    for r in ctx.db.execute("SELECT obs_id, satellite, start_utc, n_bursts, n_frames, sample_rate, "
                            "rate_status, best_snr_db, status, measured_baud, baud_ppm, "
                            "n_bursts_other, n_frames_other FROM observations "
                            "ORDER BY processed_utc DESC LIMIT 10"):
        snr = f"{r[7]:5.1f}" if r[7] is not None else "  -  "
        rate = f"{r[5]:8.0f}" if r[5] else "       -"
        bd = f"{r[9]:8.1f} {r[10]:+6.0f}ppm" if r[9] else f"{'-':>8} {'':9}"
        ob = f"+{r[11]}" if r[11] else ""
        of = f"+{r[12]}" if r[12] else ""
        print(f"  {r[0]:>9} {str(r[1])[:14]:<14} {(r[2] or '')[:16]:<16} bursts {f'{r[3] or 0}{ob}':>6} "
              f"frames {f'{r[4] or 0}{of}':>6} rate {rate} {r[6] or '':<9} baud {bd} snr {snr} {r[8]}")
    print("  (+N = bursts/frames from other transmitters sharing the channel)")
    files = glob.glob(os.path.join(ctx.iq_dir, "*.sigmf-data"))
    used = sum(os.path.getsize(f) for f in files)
    expired, _ = retention_plan(ctx)
    st = os.statvfs(ctx.iq_dir)
    print(f"IQ archive: {len(files)} files, {used / 1e9:.2f} GB; {st.f_bavail * st.f_frsize / 1e9:.1f} GB free; "
          f"retention: {len(expired)} expired ({sum(e[2] for e in expired) / 1e9:.2f} GB), "
          f"auto-delete {'on' if ctx.settings['retention_auto'] else 'off'}")
    # Same offset on every satellite of a flowgraph => station rate rule is wrong;
    # offset on one satellite only => that satellite's oscillator.
    print("flowgraph check (median baud offset per satellite):")
    rows = ctx.db.execute("SELECT flowgraph, baud, norad_id, satellite, baud_ppm FROM observations "
                          "WHERE baud_ppm IS NOT NULL").fetchall()
    groups = {}
    for fg, bd, nd, name, p in rows:
        groups.setdefault((fg, bd), {}).setdefault((nd, name), []).append(p)
    if not groups:
        print("  (no measured passes yet)")
    for (fg, bd), sats in sorted(groups.items(), key=lambda kv: str(kv[0])):
        med = {k: float(np.median(v)) for k, v in sats.items()}
        lst = ", ".join(f"{str(n)[:14]} {m:+.0f} ({len(sats[(nd, n)])})" for (nd, n), m in med.items())
        note = ""
        if len(med) >= 3 and all(abs(m) > 500 for m in med.values()) \
                and np.ptp(list(med.values())) < 300:
            note = "  <- all satellites agree: check the rate rule for this flowgraph"
        print(f"  {fg} @ {bd}: {lst}{note}")
    return 0


def recalibrate(ctx, obs):
    """Re-run parser + calibration on an observation's stored frames (no IQ needed)."""
    row = ctx.db.execute("SELECT norad_id, start_utc, decoder FROM observations WHERE obs_id=?", (obs,)).fetchone()
    if not row:
        return None
    norad, start, decoder = row
    sc = ctx.satcfg(norad)
    frames = ctx.db.execute("SELECT f.frame_id, f.data, f.t_offset_s, f.valid, t.fields FROM frames f "
                            "LEFT JOIN telemetry t USING (frame_id) WHERE f.obs_id=?", (obs,)).fetchall()
    n_pts = n_err = 0
    with ctx.db:
        ctx.db.execute("DELETE FROM points WHERE obs_id=?", (obs,))
        for fid, data, toff, valid, old in frames:
            cm = None
            if decoder == "cw":           # keep the CW link-level fields from the decode
                try:
                    o = json.loads(old) if old else {}
                except ValueError:
                    o = {}
                cm = {k: o[k] for k in CW_KEYS if k in o} or {"text": bytes(data).decode(errors="replace")}
                toff = toff if toff is not None else cm.get("t_offset_s")
            ctx.db.execute("DELETE FROM telemetry WHERE frame_id=?", (fid,))
            n_pts += store_decom(ctx, ctx.db, sc, fid, obs, norad, start, toff, bytes(data), cm, valid)
            n_err += ctx.db.execute("SELECT error IS NOT NULL FROM telemetry WHERE frame_id=?",
                                    (fid,)).fetchone() == (1,)
    return len(frames), n_pts, n_err


def cmd_recalibrate(ctx, args):
    ids = []
    for n in args.ids:                   # an observation ID, or else a NORAD ID (all its passes)
        if ctx.db.execute("SELECT 1 FROM observations WHERE obs_id=?", (n,)).fetchone():
            ids.append(n)
        else:
            got = [r[0] for r in ctx.db.execute("SELECT obs_id FROM observations WHERE norad_id=? "
                                                "ORDER BY start_utc", (n,))]
            if not got:
                print(f"{n}: no such observation or NORAD ID in the database")
            ids += got
    for obs in ids:
        r = recalibrate(ctx, obs)
        if r:
            print(f"obs {obs}: {r[0]} frames re-parsed, {r[1]} points, {r[2]} parse errors")
    return 0


def cmd_frames(ctx, args):
    rows = ctx.db.execute(
        "SELECT f.frame_id, f.obs_id, f.transmitter, f.valid, f.length, f.data, t.parser, t.fields, t.error "
        "FROM frames f LEFT JOIN telemetry t USING (frame_id) WHERE f.obs_id IN (%s) "
        "ORDER BY f.obs_id, f.transmitter, f.idx" % ",".join("?" * len(args.ids)), args.ids).fetchall()
    if not rows:
        print("no frames")
    for fid, obs, tx, ok, n, data, parser, fields, err in rows:
        if not ok and not args.all:
            continue
        tag = "scheduled" if tx == 0 else f"other #{tx}"
        print(f"obs {obs}  frame {fid}  transmitter {tx} ({tag})  {n} bytes{'' if ok else '  [SUSPECT]'}")
        for o in range(0, len(data), 16):
            chunk = data[o:o + 16]
            asc = "".join(chr(c) if 32 <= c < 127 else "." for c in chunk)
            print(f"  {o:04x}  {chunk.hex(' '):<47}  {asc}")
        if fields:
            f = json.loads(fields)
            if isinstance(f, dict):
                print("  " + "  ".join(f"{k}={v}" for k, v in f.items()))
        if err:
            print(f"  parse error ({parser}): {err}")
        pts = ctx.db.execute("SELECT name, value, unit FROM points WHERE frame_id=?", (fid,)).fetchall()
        if pts:
            print("  EU: " + "  ".join(f"{n}={v:.4g}{(' ' + u) if u else ''}" if v is not None else f"{n}=?"
                                      for n, v, u in pts))
        print()
    return 0


def main():
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)      # quiet exit when piped into head/less
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--base", default=os.environ.get("SATNOGS_LOCAL", DEFAULT_BASE))
    ap.add_argument("--config")
    ap.add_argument("--db")
    ap.add_argument("-v", "--verbose", action="store_true")
    sub = ap.add_subparsers(dest="cmd")
    r = sub.add_parser("run")
    r.add_argument("--max", type=int, default=50)
    rp = sub.add_parser("reprocess")
    rp.add_argument("ids", nargs="+", type=int)
    rp.add_argument("--mode", choices=["cw", "data"],
                    help="process as this mode, whatever was scheduled (e.g. CW heard on a GMSK pass)")
    rp.add_argument("--set", action="append", default=[], metavar="KEY=VALUE",
                    help="override a worker.yml setting for this run, e.g. --set cw_search_hz=20000")
    sub.add_parser("status")
    rc2 = sub.add_parser("recalibrate", help="re-run parser + calibration on stored frames (no IQ needed)")
    rc2.add_argument("ids", nargs="+", type=int, help="observation IDs and/or NORAD IDs (= all their passes)")
    rp2 = sub.add_parser("retention", help="list (or --apply: delete) expired IQ files")
    rp2.add_argument("--apply", action="store_true")
    fp = sub.add_parser("frames", help="print decoded frames and telemetry")
    fp.add_argument("ids", nargs="+", type=int)
    fp.add_argument("--all", action="store_true", help="include suspect frames")
    args = ap.parse_args()
    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,
                        format="%(levelname)s %(message)s" if os.environ.get("INVOCATION_ID")
                        else "%(asctime)s %(levelname)s %(message)s")
    if not os.access(args.base, os.R_OK | os.W_OK | os.X_OK):
        raise SystemExit(f"cannot access {args.base} (run as a member of group satnogs-client?)")
    ctx = Ctx(args.base, args.config or os.path.join(args.base, "worker.yml"),
              args.db or os.path.join(args.base, "station.db"))
    for d in (ctx.queue_dir, ctx.work, ctx.cache):
        os.makedirs(d, exist_ok=True)
    if args.cmd == "status":
        return cmd_status(ctx, args)
    if args.cmd == "frames":
        return cmd_frames(ctx, args)
    if args.cmd == "recalibrate":
        return cmd_recalibrate(ctx, args)
    if args.cmd == "retention":
        return cmd_retention(ctx, args)
    if args.cmd == "reprocess":
        ctx.mode_override = args.mode
        for kv in args.set:
            k, _, v = kv.partition("=")
            if k not in ctx.settings:
                raise SystemExit(f"unknown setting {k!r}")
            ctx.settings[k] = yaml.safe_load(v) if yaml else v
            log.info("setting override: %s = %r", k, ctx.settings[k])
        args.max = len(args.ids)
        return cmd_run(ctx, args, ids=args.ids)
    if args.cmd is None:
        args.max = 50
    return cmd_run(ctx, args)


if __name__ == "__main__":
    sys.exit(main())
