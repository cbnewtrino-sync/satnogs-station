def kaitai_dict(obj, depth=0):
    if depth > 12:
        return None
    if isinstance(obj, (bytes, bytearray)):
        return obj.hex()
    if isinstance(obj, (int, float, str, bool)) or obj is None:
        return obj
    if isinstance(obj, list):
        return [kaitai_dict(v, depth + 1) for v in obj]
    if hasattr(obj, "name") and hasattr(obj, "value") and type(obj).__module__ != "builtins":
        return obj.name                          # Enum
    if hasattr(obj, "_io"):
        out = {}
        for k in dir(obj):
            if k.startswith("_") or k in ("close", "from_file", "from_bytes", "from_io"):
                continue
            try:
                v = getattr(obj, k)
            except Exception:
                continue
            if callable(v) and not hasattr(v, "_io"):
                continue
            out[k] = kaitai_dict(v, depth + 1)
        return out
    return str(obj)


def jsonable(d):
    return json.loads(json.dumps(d, default=lambda o: o.hex() if isinstance(o, (bytes, bytearray))
                                 else getattr(o, "name", str(o))))


def load_parser(spec, cfgdir, cache_dir):
    """Returns (name, fn(bytes)->dict) or (None, None)."""
    if not spec or spec == "none":
        return None, None
    if spec.startswith("satnogs:"):
        from satnogsdecoders import decoder as sd
        cls = getattr(sd, spec.split(":", 1)[1])

        def parse(b):
            s = cls.from_bytes(b)
            return sd.get_fields(s) or kaitai_dict(s)
        return spec, parse
    path, _, clsname = spec.partition(":")
    path = path if os.path.isabs(path) else os.path.join(cfgdir, path)
    if path.endswith(".ksy"):
        out = os.path.join(cache_dir, "ksy")
        os.makedirs(out, exist_ok=True)
        mod = os.path.join(out, os.path.basename(path)[:-4] + ".py")
        if not os.path.exists(mod) or os.path.getmtime(mod) < os.path.getmtime(path):
            subprocess.run(["kaitai-struct-compiler", "-t", "python", "--outdir", out, path],
                           check=True, capture_output=True)
        path = mod
    spec_ = importlib.util.spec_from_file_location(f"parser_{abs(hash(path))}", path)
    m = importlib.util.module_from_spec(spec_)
    spec_.loader.exec_module(m)
    # plain Python parser: a function parse(data: bytes) -> dict (or the named one)
    f = getattr(m, clsname or "parse", None)
    if callable(f) and not isinstance(f, type):
        return spec, f
    if clsname:
        cls = getattr(m, clsname)
    else:
        from kaitaistruct import KaitaiStruct
        cls = next(v for v in vars(m).values()
                   if isinstance(v, type) and issubclass(v, KaitaiStruct) and v is not KaitaiStruct
                   and v.__module__ == m.__name__)
    return spec, lambda b: kaitai_dict(cls.from_bytes(b))


